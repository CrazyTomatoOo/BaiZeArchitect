{
  "name": "baize",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "极薄的设计校验 CLI：发号、校验、查询 baize/ 下的设计条目",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/baize-context.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "baize": "./dist/bin/baize.js"
  },
  "files": [
    "dist",
    "skills",
    "extensions",
    "scripts",
    "hooks",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/bin/baize.js', 0o755)\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check:skills": "node scripts/check-skills.mjs",
    "check:docs": "node scripts/check-doc-refs.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:fixture": "node scripts/check-fixture.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:skills && npm run check:docs && npm run check:fixture && npm run check:pack",
    "baize": "node --import tsx bin/baize.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
