    "pg": "8.16.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
