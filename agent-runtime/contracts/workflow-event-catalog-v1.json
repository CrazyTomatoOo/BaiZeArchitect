{
  "schemaVersion": "workflow-event-catalog/v1",
  "workflowEnvelope": {
    "required": ["schemaVersion", "workflowId", "seq", "type", "typeVersion", "workflowVersion", "payload", "createdAt"],
    "properties": {
      "schemaVersion": "workflow-event/v1",
      "workflowId": "positive integer",
      "seq": "positive contiguous integer within the Workflow",
      "type": "closed event type enum",
      "typeVersion": 1,
      "workflowVersion": "non-negative integer after the transaction, or unchanged for audit-only events",
      "entity": "optional exact type/id/version reference",
      "commandId": "optional command resource id",
      "actorRef": "optional trusted actor snapshot",
      "payload": "closed type-specific object containing refs, digests and reason codes rather than large content",
      "createdAt": "timestamp for display only; not ordering authority"
    }
  },
  "runEnvelope": {
    "required": ["schemaVersion", "runId", "seq", "type", "payload", "createdAt"],
    "properties": {
      "schemaVersion": "run-event/v1",
      "runId": "positive integer",
      "seq": "positive contiguous integer within the Run",
      "type": "run-local event type",
      "payload": "token/tool/process data or immutable document references",
      "createdAt": "timestamp for display only"
    }
  },
  "workflowEventTypes": {
    "workflow_created": {"entity": "workflow", "changesWorkflowVersion": false},
    "legacy_data_imported": {"entity": "legacy_import", "changesWorkflowVersion": false, "runtimeCanEmit": false},
    "workflow_started": {"entity": "workflow", "changesWorkflowVersion": true},
    "workflow_paused": {"entity": "workflow", "changesWorkflowVersion": true},
    "workflow_resumed": {"entity": "workflow", "changesWorkflowVersion": true},
    "workflow_failed": {"entity": "workflow_incident", "changesWorkflowVersion": true},
    "workflow_ready": {"entity": "approval_packet", "changesWorkflowVersion": true},
    "workflow_readiness_revoked": {"entity": "approval_packet", "changesWorkflowVersion": true},
    "workflow_archived": {"entity": "workflow", "changesWorkflowVersion": true},
    "planning_requested": {"entity": "task", "changesWorkflowVersion": true},
    "plan_adopted": {"entity": "plan_revision", "changesWorkflowVersion": true},
    "plan_superseded": {"entity": "plan_revision", "changesWorkflowVersion": true},
    "plan_validation_failed": {"entity": "task_attempt", "changesWorkflowVersion": true},
    "task_created": {"entity": "task", "changesWorkflowVersion": true},
    "task_started": {"entity": "task", "changesWorkflowVersion": true},
    "task_waiting_for_human": {"entity": "task", "changesWorkflowVersion": true},
    "task_waiting_for_replan": {"entity": "task", "changesWorkflowVersion": true},
    "task_completed": {"entity": "task", "changesWorkflowVersion": true},
    "task_failed": {"entity": "task", "changesWorkflowVersion": true},
    "task_superseded": {"entity": "task", "changesWorkflowVersion": true},
    "task_skipped_satisfied": {"entity": "task", "changesWorkflowVersion": true},
    "attempt_created": {"entity": "task_attempt", "changesWorkflowVersion": true},
    "attempt_started": {"entity": "task_attempt", "changesWorkflowVersion": true},
    "attempt_succeeded": {"entity": "task_attempt", "changesWorkflowVersion": true},
    "attempt_failed": {"entity": "task_attempt", "changesWorkflowVersion": true},
    "attempt_cancelled": {"entity": "task_attempt", "changesWorkflowVersion": true},
    "attempt_superseded": {"entity": "task_attempt", "changesWorkflowVersion": true},
    "run_queued": {"entity": "run", "changesWorkflowVersion": true},
    "run_running": {"entity": "run", "changesWorkflowVersion": true},
    "run_completed": {"entity": "run", "changesWorkflowVersion": true},
    "run_failed": {"entity": "run", "changesWorkflowVersion": true},
    "run_cancelled": {"entity": "run", "changesWorkflowVersion": true},
    "workflow_attempt_claim_acquired": {"entity": "task_attempt", "changesWorkflowVersion": true},
    "workflow_attempt_claim_released": {"entity": "task_attempt", "changesWorkflowVersion": true},
    "workflow_attempt_claim_restored": {"entity": "task_attempt", "changesWorkflowVersion": true},
    "diagnostic_run_started": {"entity": "run", "changesWorkflowVersion": false},
    "diagnostic_run_finished": {"entity": "run", "changesWorkflowVersion": false},
    "blocking_gate_opened": {"entity": "blocking_gate", "changesWorkflowVersion": true},
    "blocking_gate_resolved": {"entity": "blocking_gate", "changesWorkflowVersion": true},
    "human_directive_recorded": {"entity": "human_directive", "changesWorkflowVersion": true},
    "human_response_recorded": {"entity": "human_response", "changesWorkflowVersion": true},
    "requirement_revised": {"entity": "artifact_revision", "changesWorkflowVersion": true},
    "artifact_revision_published": {"entity": "artifact_revision", "changesWorkflowVersion": true},
    "artifact_revision_approved": {"entity": "artifact_revision", "changesWorkflowVersion": true},
    "artifact_revision_rejected": {"entity": "artifact_revision", "changesWorkflowVersion": true},
    "decision_raised": {"entity": "decision", "changesWorkflowVersion": true},
    "decision_disposition_recorded": {"entity": "decision_disposition", "changesWorkflowVersion": true},
    "finding_recorded": {"entity": "finding_thread", "changesWorkflowVersion": true},
    "finding_verified": {"entity": "finding_thread", "changesWorkflowVersion": true},
    "finding_risk_accepted": {"entity": "approval", "changesWorkflowVersion": true},
    "approval_recorded": {"entity": "approval", "changesWorkflowVersion": true},
    "approval_revoked": {"entity": "approval_revocation", "changesWorkflowVersion": true},
    "approval_packet_generated": {"entity": "approval_packet", "changesWorkflowVersion": true},
    "approval_packet_invalidated": {"entity": "approval_packet", "changesWorkflowVersion": true},
    "approval_packet_rejected": {"entity": "approval_packet", "changesWorkflowVersion": true},
    "approval_packet_approved": {"entity": "approval_packet", "changesWorkflowVersion": true},
    "readiness_evaluated": {"entity": "workflow", "changesWorkflowVersion": false},
    "command_accepted": {"entity": "workflow_command", "changesWorkflowVersion": "same transaction as command effects"},
    "command_rejected": {"entity": "workflow_command", "changesWorkflowVersion": false},
    "command_idempotency_conflict": {"entity": "workflow_command", "changesWorkflowVersion": false},
    "recovery_reconciled": {"entity": "workflow", "changesWorkflowVersion": "only when state or governed entity changes"},
    "recovery_failed": {"entity": "workflow_incident", "changesWorkflowVersion": true},
    "recovery_retried": {"entity": "workflow_incident", "changesWorkflowVersion": true},
    "outbox_delivery_exhausted": {"entity": "workflow_incident", "changesWorkflowVersion": true},
    "execution_transcript_missing": {"entity": "run", "changesWorkflowVersion": "true when current provenance is affected"},
    "late_run_result_discarded": {"entity": "run", "changesWorkflowVersion": false}
  },
  "runEventTypes": [
    "run_queued",
    "run_running",
    "token",
    "tool_started",
    "tool_completed",
    "tool_failed",
    "result_snapshot_recorded",
    "run_completed",
    "run_failed",
    "run_cancelled",
    "abort_requested",
    "late_result_discarded"
  ],
  "transactionRules": {
    "appendWithMutation": true,
    "workflowSeqAllocation": "increment workflows.last_event_seq inside the same BEGIN IMMEDIATE transaction",
    "multipleEventsPerTransaction": "allocate a contiguous sequence range; Workflow version changes at most once",
    "auditOnlyEvents": "advance event seq but not Workflow version",
    "largeContent": "store in snapshot_documents and place exact id/digest refs in payload",
    "ssePublication": "best effort after commit; durable replay is authoritative"
  },
  "ordering": {
    "workflow": ["workflowId", "seq"],
    "run": ["runId", "seq"],
    "crossWorkflow": "undefined",
    "crossRun": "undefined",
    "timestampsAuthoritative": false
  },
  "retentionV1": {
    "workflowEvents": "retain for Workflow lifetime and archive audit",
    "runEvents": "retain",
    "pruning": false
  }
}
