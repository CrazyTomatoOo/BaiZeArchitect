{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baize://schemas/model-config/v1",
  "title": "BaiZe ModelConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providers",
    "defaultRoles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "model-config/v1"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/providerEntry"
      }
    },
    "defaultRoles": {
      "$ref": "#/$defs/roleAssignmentMap"
    }
  },
  "$defs": {
    "providerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "models"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "minLength": 1
        },
        "authEnv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/modelEntry"
          }
        }
      }
    },
    "modelEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "api",
        "provider",
        "input",
        "cost",
        "contextWindow",
        "maxTokens"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "boolean"
        },
        "input": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "thinkingLevelMap": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "compat": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "cacheRead",
        "cacheWrite"
      ],
      "properties": {
        "input": {
          "type": "number",
          "minimum": 0
        },
        "output": {
          "type": "number",
          "minimum": 0
        },
        "cacheRead": {
          "type": "number",
          "minimum": 0
        },
        "cacheWrite": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "roleAssignmentMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis-analyst",
        "scenario-analyst",
        "usecase-analyst",
        "function-analyst",
        "design-architect",
        "architecture-architect",
        "data-architect",
        "api-architect",
        "critic",
        "orchestrator"
      ],
      "properties": {
        "analysis-analyst": {
          "$ref": "#/$defs/modelRef"
        },
        "scenario-analyst": {
          "$ref": "#/$defs/modelRef"
        },
        "usecase-analyst": {
          "$ref": "#/$defs/modelRef"
        },
        "function-analyst": {
          "$ref": "#/$defs/modelRef"
        },
        "design-architect": {
          "$ref": "#/$defs/modelRef"
        },
        "architecture-architect": {
          "$ref": "#/$defs/modelRef"
        },
        "data-architect": {
          "$ref": "#/$defs/modelRef"
        },
        "api-architect": {
          "$ref": "#/$defs/modelRef"
        },
        "critic": {
          "$ref": "#/$defs/modelRef"
        },
        "orchestrator": {
          "$ref": "#/$defs/modelRef"
        }
      }
    },
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}