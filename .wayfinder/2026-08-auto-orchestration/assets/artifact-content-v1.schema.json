{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baize.local/schemas/artifact-content-v1.schema.json",
  "title": "BaiZe Artifact Content v1",
  "oneOf": [
    { "$ref": "#/$defs/requirement" },
    { "$ref": "#/$defs/analysis" },
    { "$ref": "#/$defs/scenario" },
    { "$ref": "#/$defs/usecase" },
    { "$ref": "#/$defs/function" },
    { "$ref": "#/$defs/design" },
    { "$ref": "#/$defs/architecture" },
    { "$ref": "#/$defs/data" },
    { "$ref": "#/$defs/api" }
  ],
  "$defs": {
    "sourceRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "revisionId"],
          "properties": {
            "type": { "const": "requirement_revision" },
            "revisionId": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "artifactKind", "revisionId"],
          "properties": {
            "type": { "const": "artifact_revision" },
            "artifactKind": {
              "enum": ["analysis", "scenario", "usecase", "function", "design", "architecture", "data", "api"]
            },
            "revisionId": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "decisionId"],
          "properties": {
            "type": { "const": "decision" },
            "decisionId": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "findingId"],
          "properties": {
            "type": { "const": "finding" },
            "findingId": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "directiveId"],
          "properties": {
            "type": { "const": "human_directive" },
            "directiveId": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "traceLinkId"],
          "properties": {
            "type": { "const": "trace_link" },
            "traceLinkId": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "common": {
      "type": "object",
      "required": ["schemaVersion", "artifactKind", "summary", "sourceRefs"],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1 },
        "artifactKind": {
          "enum": ["requirement", "analysis", "scenario", "usecase", "function", "design", "architecture", "data", "api"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" },
          "uniqueItems": true
        },
        "diagrams": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagramSpec" }
        }
      }
    },
    "diagramSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodes", "edges"],
      "properties": {
        "type": { "const": "graph" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "impactDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": { "enum": ["yes", "no", "unknown"] },
        "rationale": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" },
          "uniqueItems": true
        }
      }
    },
    "impactProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process", "actors", "behavior", "architecture", "data", "api"],
      "properties": {
        "process": { "$ref": "#/$defs/impactDimension" },
        "actors": { "$ref": "#/$defs/impactDimension" },
        "behavior": { "$ref": "#/$defs/impactDimension" },
        "architecture": { "$ref": "#/$defs/impactDimension" },
        "data": { "$ref": "#/$defs/impactDimension" },
        "api": { "$ref": "#/$defs/impactDimension" }
      }
    },
    "requirement": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["title", "description"],
          "properties": {
            "schemaVersion": { "const": "artifact/requirement/v1" },
            "artifactKind": { "const": "requirement" },
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "goals": { "$ref": "#/$defs/stringList" },
            "nonGoals": { "$ref": "#/$defs/stringList" },
            "constraints": { "$ref": "#/$defs/stringList" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "analysis": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["goals", "nonGoals", "constraints", "acceptanceCriteria", "impactProfile", "openQuestions"],
          "properties": {
            "schemaVersion": { "const": "artifact/analysis/v1" },
            "artifactKind": { "const": "analysis" },
            "sourceRefs": { "minItems": 1 },
            "goals": { "$ref": "#/$defs/stringList", "minItems": 1 },
            "nonGoals": { "$ref": "#/$defs/stringList" },
            "constraints": { "$ref": "#/$defs/stringList" },
            "acceptanceCriteria": { "$ref": "#/$defs/stringList", "minItems": 1 },
            "impactProfile": { "$ref": "#/$defs/impactProfile" },
            "openQuestions": { "$ref": "#/$defs/stringList" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "scenarioVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "title", "actors", "preconditions", "trigger", "mainFlow", "alternateFlows", "expectedOutcome"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "actors": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "preconditions": { "$ref": "#/$defs/stringList" },
        "trigger": { "type": "string", "minLength": 1 },
        "mainFlow": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "alternateFlows": { "$ref": "#/$defs/stringList" },
        "expectedOutcome": { "type": "string", "minLength": 1 }
      }
    },
    "scenarioNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "title", "variants"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenarioVariant" }
        }
      }
    },
    "scenarioDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "title", "scenarios"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenarioNode" }
        }
      }
    },
    "scenario": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["domains"],
          "properties": {
            "schemaVersion": { "const": "artifact/scenario/v1" },
            "artifactKind": { "const": "scenario" },
            "sourceRefs": { "minItems": 1 },
            "domains": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/scenarioDomain" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "usecaseItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "goal", "preconditions", "mainFlow", "alternativeFlows", "postconditions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "preconditions": { "$ref": "#/$defs/stringList" },
        "mainFlow": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "alternativeFlows": { "$ref": "#/$defs/stringList" },
        "postconditions": { "$ref": "#/$defs/stringList", "minItems": 1 }
      }
    },
    "usecase": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["useCases"],
          "properties": {
            "schemaVersion": { "const": "artifact/usecase/v1" },
            "artifactKind": { "const": "usecase" },
            "sourceRefs": { "minItems": 1 },
            "useCases": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/usecaseItem" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "functionPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "name", "responsibility", "inputs", "outputs", "businessRules", "acceptanceCriteria"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "responsibility": { "type": "string", "minLength": 1 },
        "inputs": { "$ref": "#/$defs/stringList" },
        "outputs": { "$ref": "#/$defs/stringList" },
        "businessRules": { "$ref": "#/$defs/stringList" },
        "acceptanceCriteria": { "$ref": "#/$defs/stringList", "minItems": 1 }
      }
    },
    "functionItemNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "title", "points"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/functionPoint" }
        }
      }
    },
    "functionDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "title", "items"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/functionItemNode" }
        }
      }
    },
    "function": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["domains"],
          "properties": {
            "schemaVersion": { "const": "artifact/function/v1" },
            "artifactKind": { "const": "function" },
            "sourceRefs": { "minItems": 1 },
            "domains": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/functionDomain" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "changeUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "area", "change", "rationale", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "area": { "type": "string", "minLength": 1 },
        "change": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" },
          "uniqueItems": true
        }
      }
    },
    "design": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["changeUnits", "alternatives", "failureHandling", "testStrategy", "implementationOrder", "rolloutStrategy", "rollbackStrategy"],
          "properties": {
            "schemaVersion": { "const": "artifact/design/v1" },
            "artifactKind": { "const": "design" },
            "sourceRefs": { "minItems": 1 },
            "changeUnits": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/changeUnit" }
            },
            "alternatives": { "$ref": "#/$defs/stringList", "minItems": 1 },
            "failureHandling": { "$ref": "#/$defs/stringList", "minItems": 1 },
            "testStrategy": { "$ref": "#/$defs/stringList", "minItems": 1 },
            "implementationOrder": { "$ref": "#/$defs/stringList", "minItems": 1 },
            "rolloutStrategy": { "type": "string", "minLength": 1 },
            "rollbackStrategy": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "name", "responsibility"],
      "properties": {
        "componentId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "responsibility": { "type": "string", "minLength": 1 },
        "layer": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationshipId", "fromComponentId", "toComponentId", "interaction"],
      "properties": {
        "relationshipId": { "type": "string", "minLength": 1 },
        "fromComponentId": { "type": "string", "minLength": 1 },
        "toComponentId": { "type": "string", "minLength": 1 },
        "interaction": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "componentPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "x", "y"],
      "properties": {
        "componentId": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "relationshipWaypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationshipId", "points"],
      "properties": {
        "relationshipId": { "type": "string", "minLength": 1 },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },
    "layoutBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "componentPositions": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentPosition" }
        },
        "relationshipWaypoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationshipWaypoint" }
        },
        "boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/layoutBoundary" }
        }
      }
    },
    "architecture": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["components", "constraints", "nonFunctionalRequirements"],
          "properties": {
            "schemaVersion": { "const": "artifact/architecture/v1" },
            "artifactKind": { "const": "architecture" },
            "sourceRefs": { "minItems": 1 },
            "components": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/component" }
            },
            "relationships": {
              "type": "array",
              "items": { "$ref": "#/$defs/relationship" }
            },
            "constraints": { "$ref": "#/$defs/stringList" },
            "nonFunctionalRequirements": { "$ref": "#/$defs/stringList", "minItems": 1 },
            "layout": { "$ref": "#/$defs/layout" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "dataField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "name", "type"],
      "properties": {
        "fieldId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "nullable": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "dataEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId", "name", "fields"],
      "properties": {
        "entityId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dataField" }
        },
        "primaryKey": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "uniqueKeys": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "fields"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "dataRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromEntityId", "fromFieldIds", "toEntityId", "cardinality"],
      "properties": {
        "fromEntityId": { "type": "string", "minLength": 1 },
        "fromFieldIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "toEntityId": { "type": "string", "minLength": 1 },
        "toFieldIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cardinality": { "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"] },
        "onDelete": { "type": "string", "minLength": 1 },
        "onUpdate": { "type": "string", "minLength": 1 }
      }
    },
    "data": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["entities"],
          "properties": {
            "schemaVersion": { "const": "artifact/data/v1" },
            "artifactKind": { "const": "data" },
            "sourceRefs": { "minItems": 1 },
            "entities": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/dataEntity" }
            },
            "relations": {
              "type": "array",
              "items": { "$ref": "#/$defs/dataRelation" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "openapiParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "in"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "in": { "enum": ["query", "header", "path", "cookie"] },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "schema": { "type": "object" }
      }
    },
    "openapiResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "content": {
          "type": "object",
          "properties": {
            "application/json": {
              "type": "object",
              "properties": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "openapiOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "responses"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "operationId": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/openapiParameter" }
        },
        "requestBody": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content"],
          "properties": {
            "content": {
              "type": "object",
              "properties": {
                "application/json": {
                  "type": "object",
                  "properties": {
                    "schema": { "type": "object" }
                  }
                }
              }
            },
            "required": { "type": "boolean" }
          }
        },
        "responses": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/openapiResponse" }
        }
      }
    },
    "openapiPathItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "get": { "$ref": "#/$defs/openapiOperation" },
        "post": { "$ref": "#/$defs/openapiOperation" },
        "put": { "$ref": "#/$defs/openapiOperation" },
        "delete": { "$ref": "#/$defs/openapiOperation" },
        "patch": { "$ref": "#/$defs/openapiOperation" }
      }
    },
    "api": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["openapi", "info", "paths"],
          "properties": {
            "schemaVersion": { "const": "artifact/api/v1" },
            "artifactKind": { "const": "api" },
            "sourceRefs": { "minItems": 1 },
            "openapi": { "const": "3.1.0" },
            "info": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "version"],
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "description": { "type": "string" }
              }
            },
            "servers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["url"],
                "properties": {
                  "url": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" }
                }
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" }
                }
              }
            },
            "paths": {
              "type": "object",
              "minProperties": 1,
